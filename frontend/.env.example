# Copy to .env. Base URL of the AgroScope API.
VITE_API_URL=http://localhost:8000/api/v1

# Optional. Links in the Model Status window, if these tools aren't on their default local ports.
# VITE_MLFLOW_URL=http://localhost:5000
# VITE_GRAFANA_URL=http://localhost:3000
# VITE_AIRFLOW_URL=http://localhost:8080
# VITE_PROMETHEUS_URL=http://localhost:9090

# Optional. Free Carto Basemaps key for the street map. OpenStreetMap is used without it.
# It's visible in the browser, so limit it to your hosts in the Carto dashboard.
VITE_CARTO_API_KEY=
