# Copy to .env and fill in. Never commit .env.

# Supabase project URL and anon key, read by the API
SUPABASE_URL=
SUPABASE_KEY=

# Service role key, used by supabase/sync_db.py in place of SUPABASE_KEY. Keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=

# MLflow server started by `docker compose up`. Leave empty to use a local SQLite file.
MLFLOW_TRACKING_URI=http://localhost:5000

# Admin token for POST /retrain. Retraining stays disabled while this is empty.
RETRAIN_TOKEN=
